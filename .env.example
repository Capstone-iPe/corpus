# Copy to .env and fill in. .env and *.crt are gitignored.

EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://103.42.50.41:1035/v1
# Local: place vm02-ca.crt in the repo root (or set an absolute path).
EMBEDDINGS_CA_CERT=vm02-ca.crt
# On Render: upload Secret File "vm02-ca.crt" (mounted at /etc/secrets/vm02-ca.crt)
# and set EMBEDDINGS_CA_CERT=/etc/secrets/vm02-ca.crt
EMBEDDING_MODEL=bge-small-en-v1.5

# Shared secret; copilot-svc uses the same value as CORPUS_API_KEY.
CORPUS_API_KEY=

# Optional overrides (defaults: repo-root corpus/ and index/).
# INDEX_PATH=index
# CORPUS_DOCS_ROOT=.
# PORT=8081
